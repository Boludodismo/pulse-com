# Banco MySQL (obrigatório)
DATABASE_URL=

# Autenticação independente do Manus
AUTH_MODE=local
VITE_AUTH_MODE=local
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
LOCAL_ADMIN_NAME=Administrador
OWNER_OPEN_ID=local-owner

# Use uma sequência aleatória longa em produção
JWT_SECRET=

# Uploads ficam desativados até um provedor S3 ser configurado
STORAGE_PROVIDER=disabled

# URL pública do serviço depois do deploy
APP_BASE_URL=

# Aplicação
PORT=8080
NODE_ENV=production
VITE_APP_TITLE=Tattoo CRM
VITE_APP_LOGO=/logo.png

# OAuth Manus (opcional; use apenas com AUTH_MODE=oauth)
# OAUTH_SERVER_URL=https://api.manus.im
# VITE_OAUTH_PORTAL_URL=https://auth.manus.im
# VITE_APP_ID=

# Armazenamento S3 (opcional; use apenas com STORAGE_PROVIDER=s3)
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
