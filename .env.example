# ============================================
# POD CRM - STANDALONE / RAILWAY TEST DEPLOY
# ============================================

# DATABASE (Railway: use a reference to the MySQL service MYSQL_URL)
DATABASE_URL=mysql://user:password@host:3306/database
RUN_DB_MIGRATIONS=true

# ============================================
# AUTHENTICATION
# ============================================
# For the standalone test environment use local/local.
AUTH_MODE=local
VITE_AUTH_MODE=local
LOCAL_ADMIN_EMAIL=admin@example.com
LOCAL_ADMIN_PASSWORD=change-this-strong-password
LOCAL_ADMIN_NAME=Administrador
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters

# Optional in standalone mode. Only required when using Manus OAuth.
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
OWNER_NAME=

# ============================================
# APPLICATION URL
# ============================================
# Example: https://your-service.up.railway.app
# Railway also exposes RAILWAY_PUBLIC_DOMAIN automatically after a domain exists.
APP_BASE_URL=
PUBLIC_URL=
VITE_APP_TITLE=POD CRM - Estúdios de Tatuagem
VITE_APP_LOGO=/logo.png

# Railway injects PORT automatically. Keep 8080 for local Docker usage.
PORT=8080
NODE_ENV=production

# ============================================
# FILE STORAGE
# ============================================
# Values: s3 | manus | disabled
# For Railway use "s3" and auto-inject the Bucket credentials.
STORAGE_PROVIDER=s3

# Railway Bucket / generic S3-compatible credentials
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=auto
# Railway normally uses "virtual"; old buckets can use "path".
AWS_S3_URL_STYLE=virtual

# Manus storage proxy (only when STORAGE_PROVIDER=manus)
BUILT_IN_FORGE_API_URL=https://forge.manus.im
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=https://forge.manus.im

# ============================================
# OPTIONAL INTEGRATIONS
# ============================================
BOTCONVERSA_ENCRYPTION_KEY=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SYNC_SECRET=

# Analytics (optional)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
